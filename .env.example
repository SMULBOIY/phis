# =============================================================================
# Example environment file for the Phishing Website Detection System.
# Copy this file to ".env", then fill in the values. NEVER commit .env.
#
#   Windows (PowerShell):  copy .env.example .env
#   Linux / macOS       :  cp .env.example .env
#
# .env is listed in .gitignore. Real environment variables always take priority
# over values in this file (python-dotenv is loaded with override=False).
# =============================================================================

# Which config class to use: development | testing | production
APP_ENV=development

# WSGI bind address used by `python wsgi.py` (Stage 7). 0.0.0.0 is required
# for the Arena live preview; use 127.0.0.1 if running locally without a proxy.
HOST=0.0.0.0
PORT=5000

# REQUIRED IN PRODUCTION. Leave empty in development to get a random ephemeral
# key (sessions reset on restart). Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Paste the 64-character result after the equals sign below.
SECRET_KEY=

# Optional. Leave commented to use instance/phishing.db automatically.
# If you set it, use an ABSOLUTE SQLite path, e.g.:
#   DATABASE_URL=sqlite:///C:/Users/you/project/instance/phishing.db
# DATABASE_URL=

# Rate limits used in Stage 12 (Flask-Limiter syntax).
RATE_LIMIT_SCAN=10 per minute
RATE_LIMIT_AUTH=5 per minute
RATE_LIMIT_API=30 per hour

# Provisional UNMEASURED abstention band. Stage 6 calibrates real values on the
# validation split and stores them in ml/saved_model/metadata.json; those take
# precedence at runtime. Do not present these numbers as measured results.
DECISION_LOW_DEFAULT=0.30
DECISION_HIGH_DEFAULT=0.70

# Maximum accepted URL length in characters (input validation, Stage 10).
MAX_URL_LENGTH=2048

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Admin bootstrap credentials - consumed by scripts/create_admin.py in Stage 8.
# Leave ADMIN_PASSWORD empty; the script will refuse to create an account until
# you supply a strong one interactively or here (and this file stays untracked).
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
