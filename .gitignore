# --- Secrets and environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Database (SQLite lives in instance/, never in git) ---
instance/*.db
instance/*.sqlite
instance/*.sqlite3
*.db
*.log

# --- Model artefacts: keep the deployed bundle, ignore unselected candidate bundles ---
ml/saved_model/candidates/*.joblib

# --- Raw datasets: often large and licence-restricted; provenance is in docs/DATASET.md ---
dataset/raw/*.csv
dataset/raw/*.json
dataset/raw/*.zip

# --- Build / editor / OS ---
build/
dist/
.idea/
.DS_Store
Thumbs.db

.vercel
.env*
